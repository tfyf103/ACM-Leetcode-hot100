        "output": "-39\n"
      },
      {
        "input": " 8\t2048 \n",
        "output": "2056\n"
      },
      {
        "input": "999\n1\n",
        "output": "1000\n"
      },
      {
        "input": "\n123456  654321",
        "output": "777777\n"
      },
      {
        "input": "27 -6",
        "output": "21\n"
      },
      {
        "input": "19 81\n",
        "output": "100\n"
